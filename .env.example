# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Google Maps Platform (Browser-Restricted Key for Interactive Maps JavaScript API)
# Restrict this key in Google Cloud Console by HTTP Referrers (e.g., http://localhost:5173/* and your production domain)
# Enable only Maps JavaScript API on this browser key.
VITE_GOOGLE_MAPS_API_KEY=

# Note: GOOGLE_MAPS_SERVER_API_KEY (used by Supabase Edge Functions routecraft-maps-api and ai-mobility-assistant
# for Routes API, Places API New, and Geocoding API) MUST ONLY be set in Supabase Edge Function secrets, NEVER here.
